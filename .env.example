# Variables de docker-compose.prod.yml. Copier en .env (jamais commite) et renseigner chaque valeur.

# Domaine public : le front sur https://DOMAINE, l'API sur https://api.DOMAINE, Keycloak sur https://auth.DOMAINE
DOMAINE=tabibi.example
# Adresse de contact transmise a Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=admin@tabibi.example

# Organisation (ou compte) GitHub qui publie les images ghcr.io/ORG_GITHUB/tabibi-backend et tabibi-web
ORG_GITHUB=mon-organisation
BACKEND_TAG=latest
WEB_TAG=latest

# Secrets : longs et aleatoires (ex. openssl rand -base64 32), sans apostrophe ni espace
POSTGRES_PASSWORD=
KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=

# Instance Jitsi Meet des teleconsultations (publique par defaut, auto-hebergee de preference)
TABIBI_TELECONSULTATION_BASE_URL=https://meet.jit.si
